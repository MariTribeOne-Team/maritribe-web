# QA backend DB — Neon Postgres.
# The QA tables live in a DEDICATED schema (qa_review) inside the shared exam-prep Neon
# DB, so `prisma db push` only ever touches QA tables and never the exam_prep_* tables.
#   -> always keep &schema=qa_review on both URLs.
# Add connect_timeout=30 so a Neon cold start (compute scaled to zero when idle) does not
# fail with "Timed out fetching a new connection from the connection pool".
#
# Runtime (pooler host):
#   DATABASE_URL="postgresql://<user>:<pass>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30&schema=qa_review"
# Migrations / Prisma Studio (direct host):
#   DIRECT_URL="postgresql://<user>:<pass>@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30&schema=qa_review"
DATABASE_URL=
DIRECT_URL=

QA_JWT_SECRET="replace-with-real-secret"
QA_INTERNAL_SECRET="replace-with-real-internal-secret"
QA_JWT_EXPIRES="1d"

# Absolute base URL of THIS backend (used to build source-PDF links for the QA UI).
QA_PUBLIC_BASE_URL="http://localhost:4010"
PORT=4010
