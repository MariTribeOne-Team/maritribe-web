# Use a direct Postgres connection for runtime Prisma traffic.
# Avoid transaction pooler URLs here if the app uses interactive Prisma transactions.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maritribe_qa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/maritribe_qa?schema=public"
QA_JWT_SECRET="replace-with-real-secret"
QA_INTERNAL_SECRET="replace-with-real-internal-secret"
QA_JWT_EXPIRES="1d"
